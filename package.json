{
  "name": "tradeoff-decision-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first decision lab for explainable trade-offs, sensitivity analysis, scenarios, and optional AI-assisted framing.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "screenshots:production": "node scripts/capture-production-screenshots.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "@types/node": "26.6.1"
  },
  "homepage": "https://tradeoff-decision-lab.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/MykolaDotsenko/tradeoff-decision-lab.git"
  },
  "keywords": [
    "decision-support",
    "react",
    "typescript",
    "vite",
    "sensitivity-analysis",
    "local-first",
    "ai",
    "accessibility"
  ]
}
